{
  "name": "harustream",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_MCP_INTEGRATION=1 vitest run tests/mcp.integration.test.ts",
    "test:providers": "RUN_LIVE=1 vitest run -c vitest.live.config.ts",
    "providers:update-urls": "tsx scripts/update-provider-urls.ts",
    "pretest:providers": "pnpm providers:update-urls",
    "mcp:serve": "tsx src/mcp/index.ts",
    "mcp:watch": "tsx --watch src/mcp/index.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dashjs": "^5.2.1",
    "geist": "^1.7.2",
    "hls.js": "^1.7.1",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.0",
    "next-devtools-mcp": "^0.4.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "fast-glob": "^3.3.3",
    "p-limit": "^7.3.2",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.7.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.27.3": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "sharp@0.35.3": true
  }
}
