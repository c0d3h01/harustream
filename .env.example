# Max concurrent provider executions for fan-out endpoints and the overall
# deadline (ms) for the whole fan-out. Defaults: 6 / 12000.
# PROVIDER_CONCURRENCY=6
# PROVIDER_DEADLINE_MS=12000
# PROVIDER_TIMEOUT_MS=10000

# Structured log level for the Next.js runtime (fatal|error|warn|info|debug|trace).
# Defaults to debug in development and info in production.
# LOG_LEVEL=debug

# Web streaming proxy behaviour (/api/proxy + /api/image).
# STREAM_PROXY_USER_AGENT=Custom User-Agent presented to provider hosts.
# STREAM_PROXY_ALLOW_PRIVATE=1 permits private/internal upstream hosts (dev only).

# Optional Cloudflare Worker fronting media streams in production (src/proxy/).
# Falls back to the built-in /api/proxy when unset.
# NEXT_PUBLIC_STREAM_PROXY_URL=https://proxy.<your-subdomain>.workers.dev

# Comma-separated origins hosting poster artwork, used for preconnect.
NEXT_PUBLIC_IMAGE_ORIGINS=https://m.media-amazon.com,https://image.tmdb.org
