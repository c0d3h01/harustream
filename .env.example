# Public site name (optional). Overrides the default "harustream".
NEXT_PUBLIC_SITE_NAME=harustream

# Upstream provider API. The app proxies every catalog/meta/episode/stream
# request through this base. No provider host is hardcoded in source — set
# this to whichever provider backend you run. Required.
#
# The provider backend is a separate repo (`providers`) deployed as Netlify
# functions under /api/*. Point at that deployment:
# For local dev, run the provider repo's local server (port 8787) instead:
NEXT_PUBLIC_PROVIDER_API_URL=https://haruapi.vercel.app/

# Optional comma-separated fallback provider bases. When the primary above is
# unreachable (down, paused, rate-limiting), the app fails over to the next
# one automatically. Empty by default.
# PROVIDER_API_FALLBACK_URLS=http://localhost:8787

# Provider request timeout (ms) and max attempts (including the first) before
# giving up. The gateway itself allows 30s per call, so the client timeout must
# be higher or slow providers are aborted here first. Defaults: 15000 / 2.
# PROVIDER_TIMEOUT_MS=45000
# PROVIDER_MAX_ATTEMPTS=2

# Structured log level (fatal|error|warn|info|debug|trace). Defaults to debug
# in development and info in production.
# LOG_LEVEL=debug

# Web streaming proxy behaviour.
# STREAM_PROXY_USER_AGENT=   Custom User-Agent presented to provider hosts.
# STREAM_PROXY_REFERER=      Custom Referer presented to provider hosts.
# STREAM_PROXY_ALLOW_PRIVATE= Set "1" to permit private/internal upstream hosts (dev only).
#
# The Vega (VidSpark) CDN rejects any request whose Referer is not
# vidspark.to — the proxy injects this on every upstream media request.
STREAM_PROXY_REFERER=https://vidspark.to/

# ffmpeg binary used by /api/play (MKV → fMP4 remux). Defaults to the bundled
# ffmpeg-static binary, falling back to ffmpeg on PATH. Override only when the
# bundled binary is unsuitable (e.g. a custom build with extra codecs).
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Provider data is NOT configured here. The app fetches the live provider
# list (ids, names, availability) from the upstream API at runtime
# (GET /api/providers), and every request proxies through
# NEXT_PUBLIC_PROVIDER_API_URL above. The API is the single source of truth.

# Comma-separated origins hosting the poster artwork, used for <link
# rel="preconnect"> on first paint. Optional.
NEXT_PUBLIC_IMAGE_ORIGINS=https://m.media-amazon.com,https://image.tmdb.org
