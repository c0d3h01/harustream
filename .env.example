# Max concurrent provider executions for fan-out endpoints and the overall
# deadline (ms) for the whole fan-out. Defaults: 6 / 12000.
# PROVIDER_CONCURRENCY=6
# PROVIDER_DEADLINE_MS=12000
# PROVIDER_TIMEOUT_MS=10000

# Structured log level for the Next.js runtime (fatal|error|warn|info|debug|trace).
# Defaults to debug in development and info in production.
# LOG_LEVEL=debug

# Web streaming proxy behaviour (/api/proxy + /api/image).
# STREAM_PROXY_SECRET=Required in production to sign and verify proxy targets.
# STREAM_PROXY_TOKEN_TTL_MS=3600000 (optional signed URL lifetime, default 1h).
# STREAM_PROXY_USER_AGENT=Custom User-Agent presented to provider hosts.
# STREAM_PROXY_ALLOW_PRIVATE=1 permits private/internal upstream hosts (dev only).

# TMDB catalog (server-only): artwork, listings, trailers, cast.
# Get a key at https://www.themoviedb.org/settings/api (v3 API key).
# Required for home/search/detail; missing key renders a friendly
# configuration state instead of catalog content. Never expose with a
# NEXT_PUBLIC_ prefix — all TMDB calls run server-side.
# TMDB_API_KEY=your_tmdb_v3_api_key
# TMDB_TIMEOUT_MS=10000 (optional per-request timeout, default 10s).
