# Per-provider request timeout (ms) for the search/media fan-out.
# Defaults: 10000ms.
# PROVIDER_TIMEOUT_MS=10000

# Structured log level (fatal|error|warn|info|debug|trace).
# Defaults to debug in development and info in production.
# LOG_LEVEL=debug

# TMDB catalog (server-only): artwork, listings, trailers, cast.
# Get a key at https://www.themoviedb.org/settings/api (v3 API key).
# Missing key renders a friendly configuration state instead of catalog content.
# Never expose with a NEXT_PUBLIC_ prefix — all TMDB calls run server-side.
# TMDB_API_KEY=your_tmdb_v3_api_key
# TMDB_TIMEOUT_MS=10000 (optional per-request timeout, default 10s)

# User-Agent presented to provider hosts by the image proxy.
# STREAM_PROXY_USER_AGENT=Mozilla/5.0 ...

# A provider that needs a session of its own (a WAF clearance cookie, a token)
# takes one env var here, named after the provider. Nothing is committed.
# Run `pnpm test:providers` to see what a provider needs.

# Production values are set as server-only environment variables in the
# Vercel project settings (e.g. TMDB_API_KEY) — never NEXT_PUBLIC_, never committed.
